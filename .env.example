# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/vedvani?schema=public"

# Anthropic API key for Claude generation (leave blank to disable /api/chat generation at runtime)
ANTHROPIC_API_KEY=

# ElevenLabs API key for text-to-speech (leave blank to disable /api/tts)
ELEVENLABS_API_KEY=

# Port the app listens on (Next.js / Railway Nixpacks set this automatically in production)
PORT=3000
