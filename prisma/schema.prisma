generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuestSession {
  id           String   @id @default(uuid())
  email        String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  conversations Conversation[]
  memoryItems   MemoryItem[]
  bookmarks     Bookmark[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  conversations Conversation[]
  memoryItems   MemoryItem[]
  bookmarks     Bookmark[]
}

model Conversation {
  id             String   @id @default(uuid())
  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]

  @@index([guestSessionId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String   // "user" | "assistant"
  content        String   @db.Text
  // Phase 6: response style used when generating this assistant message
  // (BRD FR-CHAT-006): "concise" | "detailed" | "child-friendly" | "academic" | "devotional"
  responseMode   String   @default("detailed")
  createdAt      DateTime @default(now())

  citations Citation[]

  @@index([conversationId])
}

model Citation {
  id              String   @id @default(uuid())
  messageId       String
  message         Message  @relation(fields: [messageId], references: [id])
  corpusPassageId String
  corpusPassage   CorpusPassage @relation(fields: [corpusPassageId], references: [id])
  snippet         String   @db.Text
  createdAt       DateTime @default(now())

  @@index([messageId])
  @@index([corpusPassageId])
}

model CorpusPassage {
  id              String   @id @default(uuid())
  title           String
  sourceWork      String
  location        String
  language        String
  scriptText      String?  @db.Text
  translationText String   @db.Text
  sourceType      String   // "primary_text" | "paraphrase_summary"
  attribution     String
  traditionTags   String[]
  reviewStatus    String   @default("unreviewed") // "unreviewed" | "reviewed" | "flagged"
  createdAt       DateTime @default(now())

  citations Citation[]
  bookmarks Bookmark[]
}

model MemoryItem {
  id             String   @id @default(uuid())
  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  content        String   @db.Text
  createdAt      DateTime @default(now())

  @@index([guestSessionId])
  @@index([userId])
}

model Bookmark {
  id              String   @id @default(uuid())
  guestSessionId  String?
  guestSession    GuestSession? @relation(fields: [guestSessionId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  corpusPassageId String
  corpusPassage   CorpusPassage @relation(fields: [corpusPassageId], references: [id])
  note            String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([guestSessionId])
  @@index([userId])
  @@index([corpusPassageId])
}

model UserReport {
  id             String   @id @default(uuid())
  conversationId String?
  messageId      String?
  note           String   @db.Text
  status         String   @default("open") // "open" | "resolved"
  createdAt      DateTime @default(now())
}

// Phase 7: lightweight knowledge graph — entity pages with tradition-scoped
// descriptions (no single "universal" description per BRD pluralism rule),
// plus a pragmatic substring-match link to related CorpusPassage rows,
// mirroring the same pattern used by learningPaths.ts.
model KnowledgeEntity {
  id                          String   @id @default(uuid())
  name                        String
  entityType                  String   // "deity" | "concept" | "place" | "person"
  slug                        String   @unique
  // Array of { tradition: string, description: string } — same entity can
  // have multiple, clearly-labeled tradition-scoped descriptions.
  traditionScopedDescriptions Json
  // Substrings matched against CorpusPassage.title / translationText to
  // surface "related passages" without needing hand-maintained foreign keys.
  relatedPassageTitleContains String[]
  createdAt                   DateTime @default(now())
}

// Phase 11: lightweight request/observability logging. Deliberately does
// NOT store raw user message content or any other sensitive payload —
// only path/method/status/timing metadata, for basic admin analytics.
model RequestLog {
  id         String   @id @default(uuid())
  path       String
  method     String
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())
}
